# Copy to .env, then:  docker compose up --build   ->  http://localhost:8080
# DEMO setup (below): sample data + documented demo logins. NOT for real use.
ENVIRONMENT=development
SEED_DEMO_DATA=true
POSTGRES_PASSWORD=netaudit_db_pw
JWT_SECRET=demo-secret-demo-secret-demo-secret-1234
ADMIN_PASSWORD=Admin@12345
# Optional: enables Claude-powered suggestions (otherwise rule-based fallback is used)
AI_API_KEY=

# PRODUCTION: set ENVIRONMENT=production, SEED_DEMO_DATA=false, and use a random
# JWT_SECRET (openssl rand -hex 32) and a strong ADMIN_PASSWORD (12+ chars).
# The backend refuses to start in production with weak/default secrets.
