# Copy to backend/.env (never commit .env). All values are optional in development.
ENVIRONMENT=development
# Postgres URL (postgres:// and postgresql:// are accepted). Needed from Phase 6 onward.
DATABASE_URL=
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5100
MAX_UPLOAD_BYTES=2097152
# Optional. Without it the app runs fully on deterministic parsing and rules (Phase 5 fallback).
AI_API_KEY=
